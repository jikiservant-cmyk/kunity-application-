diff --git a/src/lib/payment-type-guard.ts b/src/lib/payment-type-guard.ts
new file mode 100644
index 0000000..ef4d3f3
--- /dev/null
+++ b/src/lib/payment-type-guard.ts
@@ -0,0 +1,36 @@
+/**
+ * Fail-closed payment-type resolution — pure decision logic, unit-tested
+ * without a database in tests/payment-type-guard.test.ts.
+ *
+ * Why this exists: the create-payment route used to resolve a paymentTypeCode
+ * to NULL when no paymentType row matched, and then booked the payment as a
+ * TENANT collection (isPlatformPayment = false). For Kunity's BUY_SMS code that
+ * silently routed a PLATFORM FEE into the tenant's provider float — the money
+ * settled with the tenant, the SMS credits were still granted, and nobody was
+ * alerted. An unregistered code is a configuration error and must be refused,
+ * loudly, before any money moves.
+ */
+
+/** The operator-facing message; must say what is wrong AND where to fix it. */
+export function unregisteredPaymentTypeError(applicationCode: string, paymentTypeCode: string): string {
+  return (
+    `Unknown payment type "${paymentTypeCode}" for application "${applicationCode}". ` +
+    'Register it in Setup before collecting payments.'
+  )
+}
+
+/**
+ * Returns { ok: true } when the request may proceed:
+ *   - no paymentTypeCode was supplied (legacy callers), or
+ *   - the supplied code resolved to a real paymentType row.
+ * Returns { ok: false, error } when a supplied code resolved to nothing.
+ */
+export function rejectUnregisteredPaymentType(
+  applicationCode: string,
+  paymentTypeCode: string | undefined | null,
+  resolvedPaymentType: { id?: string | null } | null | undefined,
+): { ok: true } | { ok: false; error: string } {
+  if (!paymentTypeCode) return { ok: true }
+  if (resolvedPaymentType?.id) return { ok: true }
+  return { ok: false, error: unregisteredPaymentTypeError(applicationCode, paymentTypeCode) }
+}
diff --git a/tests/payment-type-guard.test.ts b/tests/payment-type-guard.test.ts
new file mode 100644
index 0000000..db2d7ad
--- /dev/null
+++ b/tests/payment-type-guard.test.ts
@@ -0,0 +1,62 @@
+/**
+ * Unit tests for the fail-closed payment-type guard.
+ *
+ * The guard backs the create-payment route's refusal to book a payment when
+ * the requested paymentTypeCode is not registered for the application. Before
+ * the guard, an unknown code silently left paymentTypeId null and the payment
+ * was booked as a TENANT collection — for Kunity's BUY_SMS that routed a
+ * platform fee into the tenant's provider float.
+ *
+ *   npm test
+ */
+
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+
+import {
+  rejectUnregisteredPaymentType,
+  unregisteredPaymentTypeError,
+} from '../src/lib/payment-type-guard.ts'
+
+// ─── resolution outcomes ─────────────────────────────────────────────────────
+
+test('an unregistered paymentTypeCode is rejected', () => {
+  const result = rejectUnregisteredPaymentType('sacco', 'BUY_SMS', null)
+  assert.equal(result.ok, false)
+})
+
+test('the rejection names the code, the application, and where to fix it', () => {
+  const result = rejectUnregisteredPaymentType('sacco', 'BUY_SMS', null)
+  assert.ok(!result.ok)
+  assert.match(result.error, /BUY_SMS/)
+  assert.match(result.error, /sacco/)
+  assert.match(result.error, /register it in setup/i)
+})
+
+test('a registered paymentTypeCode passes', () => {
+  const result = rejectUnregisteredPaymentType('sacco', 'deposit', { id: 'pt-1' })
+  assert.deepEqual(result, { ok: true })
+})
+
+test('a registered BUY_SMS passes and stays a platform fee downstream', () => {
+  const result = rejectUnregisteredPaymentType('sacco', 'BUY_SMS', { id: 'pt-buy-sms' })
+  assert.deepEqual(result, { ok: true })
+})
+
+test('no paymentTypeCode supplied is not the guard\'s concern (legacy callers)', () => {
+  assert.deepEqual(rejectUnregisteredPaymentType('sacco', undefined, null), { ok: true })
+  assert.deepEqual(rejectUnregisteredPaymentType('sacco', null, null), { ok: true })
+})
+
+test('an empty-string code behaves like an unregistered code lookup result', () => {
+  // The route only looks up non-empty codes; an empty string reaches the guard
+  // as "not supplied".
+  assert.deepEqual(rejectUnregisteredPaymentType('sacco', '', null), { ok: true })
+})
+
+test('the message format is stable for operator tooling', () => {
+  assert.equal(
+    unregisteredPaymentTypeError('sacco', 'BUY_SMS'),
+    'Unknown payment type "BUY_SMS" for application "sacco". Register it in Setup before collecting payments.',
+  )
+})
